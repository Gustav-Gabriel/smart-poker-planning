# Chave da API KLIPY (obrigatória para busca de GIFs no avatar).
# Obtenha em https://klipy.com/developers
KLIPY_API_KEY=

# Chaves de IA (servidor). O formulário de criar sala só expõe Gemini por enquanto.
GEMINI_API_KEY=
# OPENAI_API_KEY=   # reservado; UI oculta
# ANTHROPIC_API_KEY=

# Credenciais Jira (Basic auth) — usadas em toda criação de sala.
JIRA_SITE=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=

# Porta HTTP do servidor customizado (Next + Socket.io). Padrão: 3000.
PORT=3000
